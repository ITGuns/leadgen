# LeadForge environment (procurement guide §10). Copy to .env on the host; never commit .env.
# Everything runs keyless with MOCK_MODE=1.

# Data (free)
OVERTURE_RELEASE=2026-08-19.0
OVERTURE_BASE_URL=s3://overturemaps-us-west-2/release
FSQ_RELEASE=2026-08-11
FSQ_BASE_URL=
# FSQ OS Places is a gated HF dataset (free account, auto-approved) — see BLOCKERS B6
HF_TOKEN=

# Google (free)
PAGESPEED_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# Access (Cloudflare Zero Trust)
CF_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OUTSCRAPER_API_KEY=

# App
MOCK_MODE=1
APP_SECRET=
APP_URL=https://leads.gemfieldconsulting.com
MONTHLY_SPEND_CEILING_USD=0

# Database (D19). Empty DATABASE_URL = local PGlite under PGLITE_DIR (.data/pg or /data/pg in Docker).
# For Supabase use the TRANSACTION POOLER string (…pooler.supabase.com:6543, the client already sets prepare:false).
DATABASE_URL=
PGLITE_DIR=

# Local/Docker file dirs (Vercel uses /tmp + Supabase Storage automatically)
EXPORTS_DIR=/data/exports
BACKUPS_DIR=/data/backups

# Vercel + Supabase deployment (D19/D20/D21) — leave empty for local/Docker.
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY: exports go to the private "exports" storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for Vercel Cron -> /api/jobs/tick (any long random string)
CRON_SECRET=
# App's own login (D23): set to require a password on every page/API (HTTP Basic, any username).
# Use this on Vercel free tier — Standard Protection does NOT cover the production domain.
APP_PASSWORD=
# Trust the platform's own door (Vercel Deployment Protection) instead of CF Access JWTs
AUTH_TRUST_PLATFORM=0
OPERATOR_EMAIL=
# Worker slice budget per cron tick, ms (280000 fits maxDuration=300; use 50000 on Vercel Hobby)
JOB_SLICE_MS=
